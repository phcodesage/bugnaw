# Public Supabase configuration: use the project that should serve this app.
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Server-only secrets. Never expose these through VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
LOVABLE_CRON_SECRET=
# Optional previous secret during cron-secret rotation.
LOVABLE_CRON_SECRET_PREVIOUS=
