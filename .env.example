# Public Supabase config (safe for the browser; exposed at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase config (NEVER expose to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-only) — DeepSeek chat completions
DEEPSEEK_API_KEY=

# Cron job auth (server-only) — Bearer token required on cron routes
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
